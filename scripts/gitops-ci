#!/usr/bin/env bash
# Non-privileged CI; arguments are immutable base commit and external report path.
set -euo pipefail
base=${1:?base commit required}
report=${2:?report path required}
[[ $base =~ ^[0-9a-f]{40}$ && $report == /* ]]
mkdir -p "$report"
report=$(realpath "$report")
[[ $report != "$PWD" && $report != "$PWD/"* ]]
git cat-file -e "$base^{commit}"
git diff --check "$base"
# Reject submodules and tracked symlinks: no hidden sources outside the repository.
if git ls-files --stage | awk '$1 == "120000" || $1 == "160000" {bad=1} END {exit !bad}'; then
  echo 'Tracked symlinks/submodules require a separately reviewed policy.' >&2
  exit 1
fi
# Direct local invocations need the same bootstrap as the GitHub workflow.
# Keep existing local pins; only resolve inputs when the lock is absent.
if [[ ! -e flake.lock ]]; then
  echo 'Creating missing local flake.lock for CI validation.'
  if ! nix flake lock "path:$PWD"; then
    echo 'Could not create local flake.lock; CI validation cannot continue.' >&2
    exit 1
  fi
fi
while IFS= read -r -d '' file; do
  case "$file" in
    *.nix)
      nix-instantiate --parse "$file" >/dev/null
      # Preserve the installer's existing formatting unless that file changes.
      if [[ $file != hosts/xenon/hardware-configuration.nix ]] || ! git diff --quiet "$base" -- "$file"; then
        nixfmt --check "$file"
      fi
      ;;
  esac
done < <(git ls-files -z)
bash -n scripts/gitops-ci
shellcheck scripts/gitops-ci
bash -n scripts/xenon-update tests/xenon-update
shellcheck scripts/xenon-update tests/xenon-update
bash tests/xenon-update
actionlint
python3 -m py_compile scripts/gitops-lock-policy scripts/gitops-downgrades
python3 tests/gitops-policy.py
# All evaluations and builds refuse lock mutation.
nix flake check --no-update-lock-file "path:$PWD"
nix build --no-update-lock-file --out-link "$report/new-system" "path:$PWD#nixosConfigurations.xenon.config.system.build.toplevel"
mkdir "$report/base"
git archive "$base" | tar -x -C "$report/base"
nix flake lock "path:$report/base"
nix flake check --no-update-lock-file "path:$report/base"
nix build --no-update-lock-file --out-link "$report/old-system" "path:$report/base#nixosConfigurations.xenon.config.system.build.toplevel"
for side in old new; do
  source_flake="path:$PWD"
  [[ $side == new ]] || source_flake="path:$report/base"
  nix eval --no-update-lock-file --json "$source_flake#nixosConfigurations.xenon.config" \
    --apply "$(cat scripts/gitops-snapshot.nix)" | jq -S . > "$report/$side-config.json"
  nix path-info --json --recursive "$report/$side-system" > "$report/$side-closure.json"
done
jq -e '.release == "26.05" and .stateVersion == "26.05" and .homeStateVersion == "26.05"' "$report/new-config.json" >/dev/null
diff -u "$report/old-config.json" "$report/new-config.json" > "$report/sensitive-config.diff" || [[ $? == 1 ]]
diff -ru "$report/old-system/etc/systemd/system/" "$report/new-system/etc/systemd/system/" > "$report/services.diff" || [[ $? == 1 ]]
nix store diff-closures "$report/old-system" "$report/new-system" > "$report/closure.diff"
git diff --name-status "$base" > "$report/changed-files.txt"
printf 'Manual review required; auto-merge is disabled.\n' > "$report/update-policy.txt"
scripts/gitops-downgrades "$report/old-closure.json" "$report/new-closure.json" > "$report/downgrades.txt"
