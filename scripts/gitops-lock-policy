#!/usr/bin/env python3
"""Fail closed: only Home Manager's locked release revision may advance."""
import json
import re
import sys

old, new = (json.load(open(p)) for p in sys.argv[1:])
assert old != new, "No dependency update"
a, b = old["nodes"]["home-manager"], new["nodes"]["home-manager"]
assert a["original"] == b["original"] == {
    "owner": "nix-community", "repo": "home-manager",
    "ref": "release-26.05", "type": "github",
}
assert a["inputs"] == b["inputs"] == {"nixpkgs": ["nixpkgs"]}
assert set(a) == set(b)
assert set(a["locked"]) == set(b["locked"]) == {
    "owner", "repo", "rev", "narHash", "lastModified", "type",
}
for key in ("owner", "repo", "type"):
    assert b["locked"][key] == b["original"][key]
assert re.fullmatch(r"[0-9a-f]{40}", b["locked"]["rev"])
assert re.fullmatch(r"sha256-[A-Za-z0-9+/]{43}=", b["locked"]["narHash"])
assert b["locked"]["lastModified"] >= a["locked"]["lastModified"]
assert b["locked"]["rev"] != a["locked"]["rev"]
# Includes root mappings, pinned inputs, original metadata and follows edges.
new["nodes"]["home-manager"]["locked"] = a["locked"]
assert old == new, "Unexpected lock graph change"
