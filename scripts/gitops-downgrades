#!/usr/bin/env python3
"""Conservative Nix version comparison across every named closure member."""
import json
import re
import subprocess
import sys


def packages(path):
    data = json.load(open(path))
    paths = data.keys() if isinstance(data, dict) else (p["path"] for p in data)
    result = {}
    for path in paths:
        name = path.rsplit("/", 1)[-1][33:]
        match = re.fullmatch(r"(.+?)-([0-9].*)", name)
        if match:
            result.setdefault(match[1], set()).add(match[2])
    return result


old, new = map(packages, sys.argv[1:])
failures = []
for name in sorted(old.keys() & new.keys()):
    # Mixed/multiple versions are deliberately conservative: manual review needed.
    for before in sorted(old[name] - new[name]):
        for after in sorted(new[name] - old[name]):
            comparison = subprocess.check_output([
                "nix", "eval", "--raw", "--expr",
                f'builtins.toString (builtins.compareVersions {json.dumps(before)} {json.dumps(after)})',
            ], text=True).strip()
            if comparison == "1":
                failures.append(f"{name}: {before} -> {after}")
print("\n".join(failures) if failures else "No comparable version downgrades found.")
sys.exit(bool(failures))
